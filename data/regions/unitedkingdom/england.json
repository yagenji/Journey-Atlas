  "forWhom": [
    {
      "title": "ロンドンから地方へ旅を広げたい",
      "text": "首都の街歩きに、北部の大聖堂や湖畔、南西部の田園を組み合わせたい人へ。"
    },
    {
      "title": "建物と土地の関係を眺めたい",
      "text": "砂丘の城、弧を描く住宅、潮の島を訪ね、なぜそこに建つのかを考えたい人へ。"
    },
    {
      "title": "歩く速度で景色に触れたい",
      "text": "村の小川沿いや湖岸、海岸の道で、土地の表情が変わるのをゆっくり見たい人へ。"
    }
  ],
  "notes": [
    {
      "title": "8景を一度の旅で詰め込まない",
      "text": "北東部のバンバラから南西端のコーンウォールまで広く点在する。短い旅では北部か南西部を選び、滞在拠点を絞りたい。"
    },
    {
      "title": "島と海岸では潮・風・足元を確認",
      "text": "セント・マイケルズ・マウントは潮で渡り方が変わる。訪問日の公式案内を確認し、海岸や湖水地方の散策では現地の天候と歩道の状況も確かめたい。"
    },
    {
      "title": "都市間と地方部で交通を組み替える",
      "text": "都市間は鉄道を軸に、村や海岸の区間は地域バスや車を組み合わせる。曜日や季節による便数を確認し、帰りの移動を先に決めておきたい。"
    }
  ],
