  "culture": [
    {
      "title": "湖水地方の景色には、牧畜の手が入っている",
      "text": "氷河が削った谷に、牧草地や石垣、農家の建物が折り重なる。湖水地方の文化的景観は、自然だけでなく、何世代にもわたる牧畜と土地利用によって形づくられてきた。山と湖を眺めたら、牧場を区切る石垣の線にも目を向けたい。",
      "topicKey": "lakes",
      "themeEn": "NATURE",
      "themeJa": "自然を知る",
      "icon": "landscape",
      "sourceKey": "lakeLandscape"
    },
    {
      "title": "石の村を、羊毛の仕事から眺める",
      "text": "バイブリーのアーリントン・ロウは、もともと羊毛を保管する建物としてつくられ、のちに織工の住まいとなった。水辺に並ぶ家々の景色には、コッツウォルズを支えた羊毛産業の記憶が残る。石造りの美しさの奥に、この土地の仕事の歴史が見えてくる。",
      "topicKey": "wool",
      "themeEn": "HISTORY",
      "themeJa": "歴史を知る",
      "icon": "history",
      "sourceKey": "arlingtonRow"
    },
    {
      "title": "バースは、湯と社交から街が育った",
      "text": "ローマ時代の浴場から、18世紀に発展した保養都市まで、バースでは湯が街の形を変えてきた。ロイヤル・クレセントの弧を描く住宅群も、広場や緑地とともに構想された都市の一部だ。建物一つだけでなく、歩く人の視線や空間の広がりまで眺めたい。",
      "topicKey": "bath",
      "themeEn": "CITY",
      "themeJa": "街を歩く",
      "icon": "city",
      "sourceKey": "bath"
    },
    {
      "title": "コーンウォールの土地には、別の言葉がある",
      "text": "イングランド南西端のコーンウォールには、英語とは異なるケルト系のコーンウォール語が受け継がれている。地名や看板にその綴りを見つけると、同じイギリスの中にも異なる言葉の歴史があると気づく。海岸の風景の背後にある地域の個性を知る入口になる。",
      "topicKey": "cornish",
      "themeEn": "CULTURE",
      "themeJa": "文化を知る",
      "icon": "culture",
      "sourceKey": "cornish"
    },
    {
      "title": "リヴァプールでは、音楽を過去形にしない",
      "text": "リヴァプールはビートルズを生んだ街として知られるが、音楽の営みは過去の記念物に閉じていない。多彩なジャンルの演奏が、現在もホールや小さな会場で続いている。港と移動の歴史を持つ都市の空気を、街の音からも感じてみたい。",
      "topicKey": "liverpool",
      "themeEn": "CULTURE",
      "themeJa": "文化を知る",
      "icon": "culture",
      "sourceKey": "liverpoolMusic"
    },
    {
      "title": "田園をつなぐ歩道が、旅の速度を変える",
      "text": "イングランドの田園には、土地を横切って歩くための公共の通行権（フットパス）が広がっている。車では見えない畑の境や小川沿いの道をたどると、村と農地の距離がぐっと近くなる。標識に従い、畑や家畜のいる場所では現地のルールを守って歩きたい。",
      "topicKey": "footpath",
      "themeEn": "WALK",
      "themeJa": "歩く旅",
      "icon": "hike",
      "sourceKey": "footpaths"
    }
  ],
