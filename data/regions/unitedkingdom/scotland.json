  "culture": [
    {
      "title": "石の城と古い街",
      "text": "火山岩の上に建つエディンバラ城は、王の居城から軍事拠点へと姿を変えながら、街の輪郭をつくってきた。",
      "sourceKey": "edinburghCastle"
    },
    {
      "title": "島々に残る時間",
      "text": "オークニーのスカラ・ブレイには、約5000年前の住居と石の家具が残る。現在の海辺と先史時代の暮らしがひとつの景色に重なる。",
      "sourceKey": "skaraBrae"
    },
    {
      "title": "言葉が変わる風景",
      "text": "英語のほか、スコッツ語やゲール語が文化を形づくる。地名や道路標識にも、地域ごとの言葉の重なりが現れる。",
      "sourceKey": "culture"
    }
  ],
  "forWhom": [
    {
      "title": "街と歴史を歩きたい",
      "text": "エディンバラの石造建築、城跡、オークニーの先史遺跡に惹かれる人へ。"
    },
    {
      "title": "山と海岸を歩きたい",
      "text": "ハイランドの谷、スカイ島の稜線、ヘブリディーズの海岸を見たい人へ。"
    }
  ],
  "notes": [
    {
      "title": "山の天候は街とは別に確認する",
      "text": "西ハイランドや島々では風雨が変わりやすい。徒歩ルートは現地の山岳予報とアクセス情報を出発前に確認したい。"
    },
    {
      "title": "島への移動はフェリー・航空便を確認する",
      "text": "オークニーやヘブリディーズを含める旅は、天候と運航条件を考慮して日程に余裕を持たせたい。"
    }
  ],
  "seasons": [
    {
