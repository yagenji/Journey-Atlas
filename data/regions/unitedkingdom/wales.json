  "forWhom": [
    {
      "title": "山の表情を見比べたい",
      "text": "北の鋭い岩峰から南の草の山へ。登頂だけでなく、谷や湖畔から山を眺める旅にも。"
    },
    {
      "title": "海岸を自分の足で歩きたい",
      "text": "断崖、砂浜、灯台。海辺の一区間を歩き、土地ごとの風と波の違いを感じたい人へ。"
    },
    {
      "title": "英国のなかの違いを知りたい",
      "text": "ウェールズ語、城塞、鉱山、食。イングランドとは異なる地域の歴史を知りたい人へ。"
    }
  ],
  "notes": [
    {
      "title": "山を眺めることと登ることを分ける",
      "text": "トリヴァン山は、どの登頂ルートでも岩場で手を使う。初心者向けの散策として扱わず、経験と装備に合う谷・湖畔のコースを選びたい。",
      "sourceKey": "tryfan"
    },
    {
      "title": "海岸は潮と通行可能日を確かめる",
      "text": "ロシリのワームズ・ヘッドは潮で本土と切り離される。グリーン・ブリッジ周辺は射撃演習で通行が制限されるため、直前に公式案内を確認したい。",
      "sourceKey": "rangeAccess"
    },
    {
      "title": "北部と南部を急いで結ばない",
      "text": "8景は各地に分散している。短期なら北部か南西部に絞り、山歩きや海岸散策の日とは別に、地域間の移動日を確保したい。",
      "sourceKey": "transport"
    }
  ],
