  "culture": [
    {
      "topicKey": "living-welsh",
      "themeEn": "LIFE",
      "themeJa": "言葉を知る",
      "icon": "language",
      "title": "CymruとWales、二つの名前のある土地",
      "text": "ウェールズ語でウェールズはCymru。公共の標識や案内では、英語とウェールズ語が並ぶ。地名を一つずつ確かめながら歩くと、この地域を自らの言葉で呼び続ける暮らしに触れられる。",
      "sourceKey": "language",
      "points": [
        "Cymraegは今も暮らしのなかで使われる言語",
        "Eryriなど、地図でも現地の表記を確かめたい"
      ]
    },
    {
      "topicKey": "castles-and-conquest",
      "themeEn": "HISTORY",
      "themeJa": "歴史を知る",
      "icon": "history",
      "title": "城の美しさの向こうに、征服の歴史がある",
      "text": "コンウィやハーレフの城は、イングランド王エドワード1世のウェールズ支配と結びついている。城壁の高さや海からの補給路を見ると、風景のなかに築かれた軍事と権力の仕組みが見えてくる。",
      "sourceKey": "conwy",
      "points": [
        "城をウェールズ側の歴史からも眺める",
        "守りの地形と町との関係を読む"
      ]
    },
    {
      "topicKey": "slate-working-landscape",
      "themeEn": "EARTH",
      "themeJa": "山の仕事を知る",
      "icon": "landscape",
      "title": "山の斜面には、スレートを切り出した跡が残る",
      "text": "北西ウェールズの山地には、スレートの採石場、労働者の集落、港や鉄道が結びついた産業景観が残る。岩の色や斜面の形に目を向けると、自然と人の仕事が重なった土地として山を見直せる。",
      "sourceKey": "slate",
      "points": [
        "採石場と集落、鉄道、港が一つの景観をつくる",
        "山を自然だけでなく働く場として見る"
      ]
    },
    {
      "topicKey": "eisteddfod",
      "themeEn": "CULTURE",
      "themeJa": "声を知る",
      "icon": "culture",
      "title": "詩と歌を、舞台の上で競い合う",
      "text": "アイステズヴォドは、ウェールズ語の文学、音楽、演技などを祝う祭り。景色を眺める旅に詩の朗読や歌を聴く時間を加えると、言葉が受け継がれる場にも出会える。",
      "sourceKey": "eisteddfod",
      "points": [
        "言葉と芸術が結びつく祭り",
        "参加する際は開催地と日程を公式案内で確認する"
      ]
    },
    {
      "topicKey": "coal-valleys",
      "themeEn": "LIFE",
      "themeJa": "南部を知る",
      "icon": "city",
      "title": "南部の谷には、炭鉱がつくった社会の記憶がある",
      "text": "南ウェールズを知る入口は、山や海だけではない。ブレナヴォンのビッグ・ピットでは、炭鉱とそこで働いた人々の歴史をたどれる。北部の城塞とは異なる、産業と共同体の記憶に触れたい。",
      "sourceKey": "coal",
      "points": [
        "炭鉱を通じて南部の暮らしの変化を知る",
        "坑道見学は施設の最新案内を確認する"
      ]
    },
    {
      "topicKey": "designed-portmeirion",
      "themeEn": "DESIGN",
      "themeJa": "建築を知る",
      "icon": "landmark",
      "title": "地中海風の村は、自然と建築の実験だった",
      "text": "ポートメイリオンを築いたのは、ウェールズの建築家クラフ・ウィリアムズ＝エリス。自然の美しさを損なわずに開発できるか、という考えが背景にある。色彩だけでなく、建物と河口の景観の関係を眺めたい。",
      "sourceKey": "portmeirion",
      "points": [
        "古くからの漁村ではなく、意図して設計された村",
        "斜面の建築と河口が一つの景色をつくる"
      ]
    }
  ],
