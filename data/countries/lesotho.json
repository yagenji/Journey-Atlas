      },
      {
        "id": "moroho",
        "name": "モロホ",
        "nameLocal": "Moroho",
        "text": "葉野菜を細かく刻んで火を通す家庭的な料理。青菜のやわらかな歯ざわりと、自然なほろ苦さを味わう。",
        "image": "assets/images/lesotho/approved/food-02-moroho.webp",
        "imageFraming": "SOURCE_ASPECT"
      },
      {
        "id": "motoho",
        "name": "モトホ",
        "nameLocal": "Motoho",
        "text": "発酵させたソルガムでつくる粥。穀物の香りに酸味が重なり、なめらかな口当たりをもつ。",
        "image": "assets/images/lesotho/approved/food-03-motoho.webp",
        "imageFraming": "SOURCE_ASPECT"
      },
      {
        "id": "liphaphatha",
        "name": "リファファタ",
        "nameLocal": "Liphaphatha",
        "text": "小麦粉の生地を丸く平らにして、鍋などで焼くパン。表面の焼き色と厚みのあるやわらかな生地が特徴。",
        "image": "assets/images/lesotho/approved/food-04-liphaphatha.webp",
        "imageFraming": "SOURCE_ASPECT"
      }
    ]
  },
  "travelScale": {
    "kicker": "DURATION",
    "title": "旅の目安日程",
    "intro": "地図では小さく見えても、山道では距離より移動時間が効いてくる。西部の村と歴史、高原の滝、東部の山岳公園を段階的に組み合わせる。",
    "items": [
      {
        "duration": "3〜4日",
        "title": "西部の村と歴史を歩く",
        "text": "マセルを入口に、台地の歴史とマレアレアの谷を組み合わせる。村に滞在し、近くを歩く時間を確保する。例：マセル → タバ・ボシウ → マレアレア → マセル。",
        "icon": "city"
      },
      {
        "duration": "5〜7日",
        "title": "滝と高原をつなぐ",
        "text": "西部の村にセモンコンの滝を加える。山道の移動日を分け、到着後に風景を歩く余裕をもつ。例：マセル → マレアレア → セモンコン → マセル。",
        "icon": "map"
      },
      {
        "duration": "8日以上",
        "title": "山岳地帯を一つずつ巡る",
        "text": "北部の森、ダム、高地の草原から東部の峠へ広げる。天候と道路条件に応じて順路を調整し、遠隔地を詰め込まない。例：マセル → ツェフラニャネ → ボコン → カツェ → サニ・トップ → マセル。",
        "icon": "compass"
      }
    ]
  },
  "seasons": [
    {
      "months": "9〜11月",
      "color": "#9fae91",
      "text": "春。日が長くなり、山を歩く季節へ移る。高地では冷え込みが残り、同じ日でも日差しと風で体感が変わる。"
    },
    {
      "months": "12〜2月",
      "color": "#8fa890",
      "text": "夏。雨の多い季節で、草原に緑が戻る。午後の雷雨や道路の状態を見ながら、移動と歩く時間を組み立てる。"
    },
    {
      "months": "3〜5月",
      "color": "#c6ad80",
      "text": "秋。雨が減り、日中は歩きやすい日が増える。朝晩は次第に冷えるため、高地での滞在は防寒を含めて考える。"
    },
    {
      "months": "6〜8月",
      "color": "#a4b2bb",
      "text": "冬。高地では積雪や凍結があり、峠道の通行に影響することがある。低地と高地の気温差を見て、行程に余裕をもつ。"
    }
  ],
  "transport": {
    "title": "町の間はミニバス、山の奥は車と徒歩でつなぐ",
    "text": "公共交通はマセルを中心としたミニバスや乗合タクシーが基本。景勝地や保護区を続けて巡るなら車を使い、未舗装路や急な峠は道路に合った車両と運転手を手配する。村の周辺では徒歩やガイド付きの乗馬で谷へ入る。山道は距離から所要時間を推測せず、天候と路面を確認する。",
    "icon": "road"
  },
