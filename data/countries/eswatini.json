  "travelScale": {
    "kicker": "DURATION",
    "title": "旅の目安日程",
    "intro": "西部の高地から中央の谷、東部の低地へ。以下は編集上のモデル日程で、歩く時間と保護区での滞在を分けて組み合わせる。",
    "items": [
      {
        "duration": "2〜3日",
        "title": "中央の谷を起点にする",
        "text": "ムババーネ周辺から住居と草地の保護区へ。移動を絞り、村の見学と散策に時間をとる。例：ムババーネ → マンテンガ → ムリルワネ。",
        "icon": "city"
      },
      {
        "duration": "4〜6日",
        "title": "西部の高地と水辺を巡る",
        "text": "中央部に高地の散策と北部の水辺を加える。山の道を歩く日と車で移動する日を分ける。例：ムババーネ → マロロチャ → マグガ → フォフォニャネ。",
        "icon": "map"
      },
      {
        "duration": "7日以上",
        "title": "高地から低地の野生動物へ",
        "text": "西部と中央部を巡ってから東へ移り、保護区に滞在する。高地と低地の景観を急がず比較する。例：ムババーネ → マロロチャ → マンテンガ → フラネ → ムラウラ。",
        "icon": "compass"
      }
    ]
  },
  "seasons": [
    {
      "months": "9〜11月",
      "color": "#9fae91",
      "text": "春から夏へ。気温が上がり、雨季へ移る。高地の散策は天候の変化を見ながら組み立てる。"
    },
    {
      "months": "12〜2月",
